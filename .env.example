# Backend / Express
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Google Drive: root folder containing the complete college library
GOOGLE_DRIVE_ROOT_FOLDER_ID=replace_with_drive_folder_id
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json

# Supabase project settings (server only; NEVER use the service role key in Vite)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Frontend API base URL. Leave empty for same-origin/proxy deployments; local dev uses localhost:4000 by default.
VITE_API_BASE_URL=http://localhost:4000
